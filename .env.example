# Copy this file to .env and fill in your real keys. .env is gitignored --
# never commit real API keys.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ---- Web dashboard (webapp/) password gate ----
# REQUIRED before deploying the web dashboard anywhere reachable from the
# public internet -- without APP_PASSWORD set, the dashboard has NO login
# at all, and "Start run" spends real money on the keys above. Leave
# APP_PASSWORD unset for local-only use (python run_web.py on localhost);
# set both before deploying. See DEPLOY.md.
APP_USERNAME=admin
APP_PASSWORD=
